# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=budget_secure_password
POSTGRES_DB=budget_db
DATABASE_URL=postgresql+asyncpg://budget_user:budget_secure_password@db:5432/budget_db
ALEMBIC_DATABASE_URL=postgresql+asyncpg://budget_user:budget_secure_password@127.0.0.1:5432/budget_db

# ── Authentication ─────────────────────────────────────────────────
SECRET_KEY=change-me-generate-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]
